{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2023", "DOM"],
    "types": ["node", "electron-vite/node"],
    "outDir": "out/.tsc-node"
  },
  "include": [
    "electron.vite.config.ts",
    "vitest.config.mts",
    "playwright.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "scripts/**/*",
    "e2e/**/*"
  ]
}
